    <!--
      Matches surface/background in the Compose theme. Without it the pre-Compose window paints
      the platform default, so launching in dark mode flashed a white screen before the app drew
      itself. The night variant is in values-night/.
    -->
    <color name="window_background">#FFFBF8FF</color>
