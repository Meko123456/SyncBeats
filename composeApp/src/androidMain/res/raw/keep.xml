<?xml version="1.0" encoding="utf-8"?>
<!--
  default_web_client_id is generated by the google-services plugin and read reflectively by
  AndroidGoogleAuthController, because referencing it directly would fail to compile on a checkout
  whose Firebase config has no OAuth client. Resource shrinking cannot see a reflective reference,
  so without this it would be stripped and Google sign-in would break in release builds only —
  the worst kind of failure to find, since debug builds are unaffected.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
